# Postgres (ichki tarmoqda, host'ga port ochilmagan)
POSTGRES_USER=kpi
POSTGRES_PASSWORD=kpi
POSTGRES_DB=kpi
DATABASE_URL=postgresql://kpi:kpi@postgres:5432/kpi

# Redis (ichki tarmoqda, host'ga port ochilmagan)
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=changeme-in-production
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
ENV=development

# Birinchi ishga tushirishda avtomatik yaratiladigan Super Admin (docs/DEPLOY.md)
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=changeme-in-production

# Frontend server-side'dan backendga ichki tarmoq orqali murojaat qilish uchun
INTERNAL_API_URL=http://backend:8000

# HEMIS OAuth2 (universitet SSO orqali kirish) - docs/HEMIS_OAUTH.md ga qarang
# Client ID/Secret HEMIS admin panelidan ("OAuth ilovalar" bo'limidan) olinadi.
HEMIS_BASE_URL=https://hemis.xiuedu.uz
HEMIS_CLIENT_ID=
HEMIS_CLIENT_SECRET=
# HEMIS ilova sozlamalarida ro'yxatdan o'tkazilgan callback manzili bilan aynan bir xil bo'lishi shart
HEMIS_REDIRECT_URI=http://localhost:6100/api/v1/auth/hemis/callback
# Foydalanuvchi HEMIS orqali kirgandan keyin qaytariladigan frontend manzili
FRONTEND_BASE_URL=http://localhost:6100

# HEMIS REST API (xodimlar katalogi, server-server) - yuqoridagi OAuth'dan MUSTAQIL,
# alohida token. HEMIS admin panelida ("API" yoki "Token" bo'limida) generatsiya
# qilinadi. Faqat "HEMIS'dan sinxronlash" tugmasi (Xodim tafsiloti sahifasida) uchun
# kerak - token bo'sh bo'lsa, tugma bosilganda tushunarli xato ko'rsatiladi.
HEMIS_REST_BASE_URL=https://student.xiuedu.uz/rest
HEMIS_API_TOKEN=

# Backend, Frontend - ichki tarmoqda, host'ga port ochilmagan (faqat nginx orqali chiqadi)

# Nginx - yagona tashqi (host) port, production'da shu port/domen orqali proxy qilinadi
# Eslatma: 6000 ishlatilmadi - u X11 uchun band bo'lgani sababli brauzerlar
# (Chrome/Firefox) buni "xavfsiz emas" deb bloklaydi (ERR_UNSAFE_PORT).
NGINX_PORT=6100

# ops/backup.sh nechta kunlik zaxira nusxalarini saqlashi (eskirganlari avtomatik o'chiriladi)
BACKUP_RETENTION_DAYS=14
